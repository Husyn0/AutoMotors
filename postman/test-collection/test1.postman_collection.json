{
  "info": {
    "name": "test1 — Auth, Public Content, CRUD",
    "description": "Equivalent Postman collection for test1.md — login, register, refresh, rate limiting, public GET endpoints, image uploading, and protected CRUD operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE", "value": "http://127.0.0.1:8000/api" },
    { "key": "TOKEN", "value": "" },
    { "key": "IMG", "value": "/home/hkali/Desktop/VioletPro/wallpaper/arch1.png" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('TOKEN');",
          "if (!token) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('BASE') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@automotors.com', password: 'password123' }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      pm.collectionVariables.set('TOKEN', res.json().token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "0.1 Export base URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}", "host": ["{{BASE}}"], "path": [] }
          },
          "response": []
        },
        {
          "name": "0.2 Clear limiter state (dev only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run: php artisan cache:clear"
          },
          "response": []
        },
        {
          "name": "0.3 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('TOKEN', j.token); }",
                  "pm.test('token present', () => pm.expect(j.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@automotors.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "0.4 Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Admin\",\n  \"email\": \"test@automotors.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": { "raw": "{{BASE}}/auth/register", "host": ["{{BASE}}"], "path": ["auth", "register"] }
          },
          "response": []
        },
        {
          "name": "0.5 Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE}}/auth/refresh", "host": ["{{BASE}}"], "path": ["auth", "refresh"] }
          },
          "response": []
        },
        {
          "name": "0.6 Rate limiting — 5 wrong attempts",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"WRONG123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] },
            "description": "Run 5 iterations; expect 5×401."
          },
          "response": []
        },
        {
          "name": "0.7 Sixth wrong attempt — 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After present', () => pm.response.to.have.header('Retry-After'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"WRONG123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "0.8 Correct password while locked — 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        }
      ]
    },
