{
  "info": {
    "name": "test3 — Rate Limiter Suite",
    "description": "Equivalent Postman collection for test3.md — api limiter, api-authed, api-writes, uploads, api-anon, login limiter, concurrent burst, cache store inspection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE", "value": "http://127.0.0.1:8000/api" },
    { "key": "TOKEN", "value": "" },
    { "key": "IMG", "value": "/home/hkali/Desktop/VioletPro/wallpaper/arch1.png" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('TOKEN');",
          "if (!token) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('BASE') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@automotors.com', password: 'password123' }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      pm.collectionVariables.set('TOKEN', res.json().token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "0.1 Export base URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}", "host": ["{{BASE}}"], "path": [] }
          },
          "response": []
        },
        {
          "name": "0.2 Login and store token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('TOKEN', j.token); }",
                  "pm.test('token present', () => pm.expect(j.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@automotors.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "0.3 Confirm cache store (tinker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. api limiter — 120/min per IP",
      "item": [
        {
          "name": "1.1 Hammer GET /products 130×",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] },
            "description": "Run 130 iterations via Collection Runner; expect 120×200 then 10×429."
          },
          "response": []
        },
        {
          "name": "1.2 Confirm 429 shape and headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After header present', () => pm.response.to.have.header('Retry-After'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "1.3 Recovery after 60s",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Wait 65s manually before running this",
                  "pm.test('status is 200 after window', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "1.4 Per-IP independence (optional)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] },
            "description": "Run with --interface 127.0.0.2 in terminal; Postman cannot bind source IP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. api-authed limiter — 300/min per user, 30/min anon",
      "item": [
        {
          "name": "2.1 Authenticated bucket — hammer /auth/me 320×",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE}}/auth/me", "host": ["{{BASE}}"], "path": ["auth", "me"] },
            "description": "Run 320 iterations; expect 300×200 then 20×429."
          },
          "response": []
        },
        {
          "name": "2.2 Anonymous fallback — 30/min per IP",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/auth/me", "host": ["{{BASE}}"], "path": ["auth", "me"] },
            "description": "Run 400 iterations; expect 30×200 then 370×429."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. api-writes limiter — 20/min per user",
      "item": [
        {
          "name": "3.1 Twenty-five PUT /products/2",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\": 79.99}" },
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] },
            "description": "Run 25 iterations; expect 20×200 then 5×429."
          },
          "response": []
        },
        {
          "name": "3.2 Confirm Retry-After + JSON body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After header present', () => pm.response.to.have.header('Retry-After'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\": 79.99}" },
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] }
          },
          "response": []
        },
        {
          "name": "3.3 Recovery after 60s",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\": 79.99}" },
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] },
            "description": "Wait 65s manually then run."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. uploads limiter — 10/min per user",
      "item": [
        {
          "name": "4.1 Fifteen uploads",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{IMG}}" }
              ]
            },
            "url": { "raw": "{{BASE}}/uploads/products", "host": ["{{BASE}}"], "path": ["uploads", "products"] },
            "description": "Run 15 iterations; expect 10×201 then 5×429."
          },
          "response": []
        },
        {
          "name": "4.2 Confirm 429 body and headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{IMG}}" }
              ]
            },
            "url": { "raw": "{{BASE}}/uploads/products", "host": ["{{BASE}}"], "path": ["uploads", "products"] }
          },
          "response": []
        },
        {
          "name": "4.3 Recovery after 60s",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{IMG}}" }
              ]
            },
            "url": { "raw": "{{BASE}}/uploads/products", "host": ["{{BASE}}"], "path": ["uploads", "products"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. api-anon limiter — 60/min per IP",
      "item": [
        {
          "name": "5.1 Seventy hits on api-anon route",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] },
            "description": "Run 200 iterations; expect 60×200 then 140×429."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Login limiter — 5/email, 20/IP, 5/email+IP (15-min window)",
      "item": [
        {
          "name": "6.1 Five wrong attempts → 5×401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"WRONG123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] },
            "description": "Run 5 iterations; expect 5×401."
          },
          "response": []
        },
        {
          "name": "6.2 Sixth attempt → 429 with Retry-After",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After header present', () => pm.response.to.have.header('Retry-After'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"WRONG123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "6.3 Correct password while locked → 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@automotors.com\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "6.4 Email-rotation from same IP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"WRONG123\"}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] },
            "description": "Run 25 iterations with different emails; expect 20×401 then 5×429."
          },
          "response": []
        },
        {
          "name": "6.5 Reset login limiter (dev only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run: php artisan cache:clear"
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Concurrent burst",
      "item": [
        {
          "name": "7.1 Sixty parallel requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] },
            "description": "Run 60 iterations with concurrency via Collection Runner."
          },
          "response": []
        },
        {
          "name": "7.2 One hundred fifty parallel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] },
            "description": "Run 150 iterations with concurrency."
          },
          "response": []
        }
      ]
    },
    {
      "name": "8. Confirm cache store writes",
      "item": [
        {
          "name": "8.1 Trip write limit and inspect cache",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\": 79.99}" },
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] },
            "description": "Run 22 iterations then inspect via tinker."
          },
          "response": []
        }
      ]
    },
    {
      "name": "9. Clear everything",
      "item": [
        {
          "name": "9.1 Clear all limiters",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run: php artisan cache:clear && echo 'all limiters reset'"
          },
          "response": []
        }
      ]
    }
  ]
}