{
  "info": {
    "name": "test4 — Cache Verification Suite",
    "description": "Equivalent Postman collection for test4.md — cache smoke tests, locale isolation, version-stamp invalidation, cross-resource invalidation, show-endpoint isolation, settings cache, service filter isolation, non-GET traffic, TTL, negative caching, stress, failure recovery.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE", "value": "http://127.0.0.1:8000/api" },
    { "key": "TOKEN", "value": "" },
    { "key": "IMG", "value": "/home/hkali/Desktop/VioletPro/wallpaper/arch1.png" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login if TOKEN is empty",
          "const token = pm.collectionVariables.get('TOKEN');",
          "if (!token) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('BASE') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@automotors.com', password: 'password123' }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      const j = res.json();",
          "      pm.collectionVariables.set('TOKEN', j.token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "0.1 Confirm cache store (tinker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run in terminal: php artisan tinker --execute=\"echo get_class(cache()->store()) . PHP_EOL;\""
          },
          "response": []
        },
        {
          "name": "0.2 Login and store token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('TOKEN', j.token); }",
                  "pm.test('token present', () => pm.expect(j.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@automotors.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{BASE}}/auth/login", "host": ["{{BASE}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "0.3 Helper — list cache keys (tinker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run in terminal: cache_keys() { php artisan tinker --execute=\"...\"; }"
          },
          "response": []
        },
        {
          "name": "0.4 Helper — reset_all (tinker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE}}/../tinker", "host": ["{{BASE}}"], "path": ["..", "tinker"] },
            "description": "Run in terminal: php artisan cache:clear"
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Sanity — cache is written",
      "item": [
        {
          "name": "1.1 One GET /products creates cache entries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "1.2 Second call faster",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "1.3 Response body identical on cache hit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response body present', () => pm.expect(pm.response.text()).to.be.a('string'));",
                  "// Compare hashes manually across 3 runs"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Locale isolation",
      "item": [
        {
          "name": "2.1 FR list",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept-Language", "value": "fr" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "2.2 EN list",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept-Language", "value": "en" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "2.3 ?lang=en matches Accept-Language: en",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{BASE}}/products?lang=en",
              "host": ["{{BASE}}"],
              "path": ["products"],
              "query": [{ "key": "lang", "value": "en" }]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Version-stamp invalidation",
      "item": [
        {
          "name": "3.1 Warm list cache",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "3.1b POST new product (busts version)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cache Probe Product\",\n  \"category_id\": 1,\n  \"price\": 1.23,\n  \"short_description\": \"cache test\"\n}"
            },
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "3.3 Post-write GET returns fresh data",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products", "host": ["{{BASE}}"], "path": ["products"] }
          },
          "response": []
        },
        {
          "name": "3.4 Update invalidates (PUT /products/2)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\": 42.42}" },
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] }
          },
          "response": []
        },
        {
          "name": "3.4b GET /products/2 reflects new price",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{BASE}}/products/2", "host": ["{{BASE}}"], "path": ["products", "2"] }
          },
          "response": []
        },
        {
          "name": "3.5 Destroy invalidates",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{BASE}}/products/999", "host": ["{{BASE}}"], "path": ["products", "999"] },
            "description": "Replace 999 with an actual throwaway product id created beforehand."
          },
          "response": []
        }
      ]
    },
    {
